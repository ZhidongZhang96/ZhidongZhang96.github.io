---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import rehypeKatex from "rehype-katex";
import remarkMath from "remark-math";

interface Props {
	points: string[];
}

const { points } = Astro.props;
const orderedPointRegex = /^\d+\.\s+(.*)$/;
const isOrderedList =
	points.length > 0 && points.every((point) => orderedPointRegex.test(point.trim()));

const processor = await createMarkdownProcessor({
	remarkPlugins: [remarkMath],
	rehypePlugins: [rehypeKatex],
});

const renderedPoints = await Promise.all(
	(isOrderedList ? points.map((point) => point.trim().replace(orderedPointRegex, "$1")) : points).map(
		async (point) => (await processor.render(point)).code,
	),
);
---

<div class="mb-8" role="note" aria-label="Article summary">
	<h2 class="mt-0 before:text-gray-600! hover:before:text-gray-600!">TLDR</h2>
	{
		isOrderedList ? (
			<ol>
				{renderedPoints.map((html) => <li set:html={html} />)}
			</ol>
		) : (
			<ul>
				{renderedPoints.map((html) => <li set:html={html} />)}
			</ul>
		)
	}
</div>
