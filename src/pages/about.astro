---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"M.Sc Student in Computational Neuroscience at University of Tübingen.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">About</h1>
	<div class="index-content">
		<p>
			My name is Zhang (张) Zhidong (志东). I am currently a first-year
			master's student in <strong>Computational Neuroscience</strong> at the
			<a class="typefolio-link inline-block" href="https://www.neuroschool-tuebingen.de" rel="noreferrer" target="_blank"
				>University of Tübingen</a
			>. Before this, I completed my Bachelor's in <strong>Software Engineering</strong> at
			<a class="typefolio-link inline-block" href="https://www.whu.edu.cn/" rel="noreferrer" target="_blank"
				>Wuhan University</a
			>.
		</p>
		<p>
			I am passionate about the intersection of artificial intelligence and
			neuroscience. While still exploring my research interests, I am particularly
			drawn to the fields of neural dynamics, memory mechanisms, and brain-inspired AI.
		</p>
		<p>
			Beyond research, I enjoy reading, thinking about the mind and consciousness, occasional writing, and hanging around at BiliBili.
		</p>
	</div>
</PageLayout>
